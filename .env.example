# CrayonJapan auto-maker - copy to .env and fill in your own values.
# .env is git-ignored; never commit the real IDs or keys.

# Gemini API key (Google AI Studio)
GEMINI_API_KEY=

# Google Drive hub folders (AI秘書 / 12_動画自動作成 / ...)
# Open each folder in the browser and copy the ID from the URL:
#   https://drive.google.com/drive/folders/<FOLDER_ID>
DRIVE_RAW_FOLDER_ID=
DRIVE_READY_FOLDER_ID=
DRIVE_ARCHIVE_FOLDER_ID=

# Optional: seconds between Drive scans for --drive-watch
# DRIVE_WATCH_INTERVAL_SECONDS=60
