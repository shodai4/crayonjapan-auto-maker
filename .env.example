# CrayonJapan auto-maker - copy to .env and fill in your own values.
# .env is git-ignored; never commit the real IDs or keys.

# Gemini API key (Google AI Studio)
GEMINI_API_KEY=

# Google Drive hub folders (AI秘書 / 12_動画自動作成 / ...)
# Open each folder in the browser and copy the ID from the URL:
#   https://drive.google.com/drive/folders/<FOLDER_ID>
DRIVE_RAW_FOLDER_ID=
DRIVE_READY_FOLDER_ID=
DRIVE_ARCHIVE_FOLDER_ID=

# Optional: seconds between Drive scans for --drive-watch
# DRIVE_WATCH_INTERVAL_SECONDS=60

# Optional: a Drive folder for the learning state (performance.csv and
# improvement_state.json). Leave empty to use the archive folder (03_ARCHIVE).
# DRIVE_STATE_FOLDER_ID=

# Optional in GitHub Actions: a long-lived Drive token JSON (content of
# drive_token.json), or the short-lived GDRIVE_ACCESS_TOKEN that the Apps Script
# trigger sends with each dispatch. Leave empty for local runs.
# GDRIVE_TOKEN_JSON=
# GDRIVE_ACCESS_TOKEN=

# Optional in GitHub Actions: the YouTube token (content of token.json) as a
# JSON string, so a scheduled run can read the channel and upload without a
# token file on the runner. Leave empty locally: token.json is used instead.
# YOUTUBE_TOKEN_JSON=
